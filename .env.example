# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - UNERMB PNF EN INFORMÁTICA
# ==============================================================================

# Entorno de Puerto (En Railway se inyecta automáticamente)
PORT=3000

# Conexión a Base de Datos MySQL
# Opción 1: Cadena de conexión directa (Provista automáticamente por Railway como MYSQL_URL o DATABASE_URL)
# MYSQL_URL=mysql://root:password@containers-us-west-xxx.railway.app:3306/railway
# DATABASE_URL=mysql://root:password@containers-us-west-xxx.railway.app:3306/railway

# Opción 2: Parámetros individuales (Railway o desarrollo local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=asistencia_unermb
DB_PORT=3306

# Secretos Criptográficos
JWT_SECRET=UNERMB_PNF_JWT_SUPER_SECRET_KEY_2026_PRODUCTION
QR_HMAC_SECRET=UNERMB_PNF_HMAC_SECRET_KEY_ASISTENCIA_2026
